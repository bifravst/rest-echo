{
  "name": "@bifravst/rest-echo",
  "version": "0.0.0-development",
  "description": "A REST echo server used for the Nordic Developer Academy developed using AWS CDK in TypeScript.",
  "type": "module",
  "scripts": {
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test:e2e": "node --experimental-transform-types --no-warnings ./features/run-features.ts > e2e-test-result.json && cat e2e-test-result.json | node --experimental-transform-types --no-warnings ./features/console-reporter.ts --only-failed --with-timestamps",
    "test": "node --experimental-transform-types --no-warnings --test ./**/*.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/rest-echo.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/rest-echo/issues"
  },
  "homepage": "https://github.com/bifravst/rest-echo#readme",
  "keywords": [
    "nordicsemiconductor",
    "nordic-developer-academy",
    "aws",
    "cdk",
    "rest"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1128.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1128.0",
    "@aws-sdk/client-dynamodb": "3.1128.0",
    "@aws-sdk/client-iam": "3.1128.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@bifravst/bdd-markdown": "9.0.2",
    "@bifravst/ci": "3.0.1",
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/eslint-config-typescript": "8.0.5",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "2.1140.0",
    "aws-cdk-lib": "2.265.0",
    "cdk": "2.1140.0",
    "chalk": "6.0.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "constructs": "10.8.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsonata": "2.2.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1128.0",
    "@bifravst/from-env": "4.0.0"
  }
}
